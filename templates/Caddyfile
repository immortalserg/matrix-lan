    # Onboarding is routed to the dedicated authorization backend, not the
    # legacy single-owner chat adapter. Preserve paths for the API handler.
    @onboarding path /api/admin/bridges /api/admin/bridges/* /api/setup/* /api/auth/register /api/admin/invites /api/admin/invites/* /api/admin/users /api/admin/users/*
    handle @onboarding {
        @onboarding_bad_origin {
            header Origin *
            not header_regexp Origin ^https://__SERVER_RE__:(18081|18008)$
        }
        route {
            respond @onboarding_bad_origin 403
            reverse_proxy authorization:8081 {
                header_down Cache-Control "no-store"
            }
        }
    }

    @api path /api/*
    handle @api {
        reverse_proxy chat-api:8080
    }

    @matrix path /_matrix/* /_synapse/client/*
    handle @matrix {
        reverse_proxy synapse:8008
    }

    handle {
        reverse_proxy element:80
    }
