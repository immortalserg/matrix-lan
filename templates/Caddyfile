{
    default_sni __SERVER_NAME__
}

https://__SERVER_NAME__:18443 {
    tls internal



    handle_path /matrix-accounts/* {
        @bad_origin_accounts {
            header Origin *
            not header_regexp Origin ^https://__SERVER_RE__:(18081|18008)$
        }
        @bad_path_accounts not path /v1/accounts /v1/refresh /v1/msb-cbmrs/settings /v1/msb-cbmrs/test /v1/accounts/delete
        @bad_method_accounts not method GET POST
        route {
            respond @bad_origin_accounts 403
            respond @bad_path_accounts 404
            respond @bad_method_accounts 405
            reverse_proxy matrix-accounts:29400 {
                transport http {
                    response_header_timeout 110s
                }
                header_down -Access-Control-Allow-Origin
                header_down -Access-Control-Allow-Credentials
                header_down Cache-Control "private, no-store"
            }
        }
    }

    # Matrix account onboarding: native Matrix user authentication, no shared secrets in the browser.
    handle_path /matrix-onboarding/email/* {
        @bad_origin_email {
            header Origin *
            not header_regexp Origin ^https://__SERVER_RE__:(18081|18008)$
        }
        @bad_path_email not path /v3/whoami /v3/login/flows /v3/login/start/* /v3/login/step/* /v3/login/cancel/*
        @bad_method_email not method GET POST
        route {
            respond @bad_origin_email 403
            respond @bad_path_email 404
            respond @bad_method_email 405
            rewrite * /_matrix/provision{uri}
            reverse_proxy mautrix-email:29319 {
                header_down -Access-Control-Allow-Origin
                header_down -Access-Control-Allow-Credentials
                header_down Cache-Control "private, no-store"
                transport http {
                    response_header_timeout 80s
                }
            }
        }
    }

