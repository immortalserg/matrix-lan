  "db": {
    "image": "postgres:16-alpine",
    "environment": {
      "POSTGRES_USER": "postgres",
      "POSTGRES_PASSWORD": "__SECRET_COMPOSE_DB_ENVIRONMENT_POSTGRES_PASSWORD__",
      "POSTGRES_DB": "postgres"
    },
    "healthcheck": {
