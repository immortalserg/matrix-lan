    },
    "verification_levels": {
      "receive": "unverified",
      "send": "unverified",
      "share": "cross-signed-tofu"
    },
    "rotation": {
      "enable_custom": false,
      "milliseconds": 604800000,
      "messages": 100,
      "disable_device_change_key_rotation": false
    }
  },
  "logging": {
    "min_level": "info",
    "writers": [
      {
        "type": "stdout",
        "format": "json"
      }
    ]
  }
}
